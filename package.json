{
  "name": "supplytrace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:worker",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm audit --audit-level=high && npm run test:e2e",
    "db:migrate:local": "wrangler d1 migrations apply supplytrace-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply supplytrace-db --remote",
    "deploy": "npm run build && wrangler deploy",
    "cf:typegen": "wrangler types"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "undici": "7.29.0"
  },
  "dependencies": {
    "@fontsource/fira-code": "5.3.0",
    "@fontsource/fira-sans": "5.3.0",
    "hono": "4.13.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.0",
    "@cloudflare/vitest-pool-workers": "0.20.2",
    "@cloudflare/workers-types": "5.20260804.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.119.0"
  }
}
